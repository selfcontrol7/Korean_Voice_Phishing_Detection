{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper2.v2/work9/work9_epoch_trace.schema.json",
  "title": "Work 9 immutable validation-call-NLL epoch trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "protocol_id", "run_family",
    "partition_repeat", "outer_fold", "seed", "condition", "monitor",
    "tie_break", "epochs", "selected_epoch"
  ],
  "properties": {
    "schema_version": {"const": "paper2-v2-work9-epoch-trace-1"},
    "run_id": {"type": "string"}, "protocol_id": {"type": "string"},
    "run_family": {"const": "primary_matrix"}, "partition_repeat": {"const": 0},
    "outer_fold": {"type": "integer", "minimum": 0, "maximum": 4},
    "seed": {"type": "integer"}, "condition": {"type": "string"},
    "monitor": {"const": "validation_call_nll"},
    "tie_break": {"const": "earlier_epoch"},
    "selected_epoch": {"type": "integer", "minimum": 1},
    "epochs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "epoch", "validation_call_nll", "train_reported_loss",
          "diagnostic_threshold", "checkpoint", "validation_segment_scores",
          "validation_call_scores"
        ],
        "properties": {
          "epoch": {"type": "integer", "minimum": 1},
          "validation_call_nll": {"type": "number", "minimum": 0},
          "train_reported_loss": {"type": "number", "minimum": 0},
          "diagnostic_threshold": {"type": "number", "minimum": 0, "maximum": 1},
          "checkpoint": {"$ref": "#/$defs/artifact"},
          "validation_segment_scores": {"$ref": "#/$defs/artifact"},
          "validation_call_scores": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "row_count"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "row_count": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
