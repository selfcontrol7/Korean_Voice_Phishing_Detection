{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper2.v2/work9/work9_run_artifact_index.schema.json",
  "title": "Work 9 completed outer-run artifact inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "protocol_id", "run_family", "condition",
    "partition_repeat", "outer_fold", "seed", "selection_index",
    "selection_seal", "checkpoint", "epoch_trace", "threshold_trace",
    "outer_eval_segments", "outer_eval_calls", "outer_eval_metrics", "run_record"
  ],
  "properties": {
    "schema_version": {"const": "paper2-v2-work9-run-artifact-index-1"},
    "run_id": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "run_family": {"const": "primary_matrix"},
    "condition": {"type": "string", "minLength": 1},
    "partition_repeat": {"const": 0},
    "outer_fold": {"type": "integer", "minimum": 0, "maximum": 4},
    "seed": {"type": "integer"},
    "selection_index": {"$ref": "#/$defs/artifact"},
    "selection_seal": {"$ref": "#/$defs/artifact"},
    "checkpoint": {"$ref": "#/$defs/artifact"},
    "epoch_trace": {"$ref": "#/$defs/artifact"},
    "threshold_trace": {"$ref": "#/$defs/artifact"},
    "outer_eval_segments": {"$ref": "#/$defs/artifact"},
    "outer_eval_calls": {"$ref": "#/$defs/artifact"},
    "outer_eval_metrics": {"$ref": "#/$defs/artifact"},
    "run_record": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "row_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "row_count": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
